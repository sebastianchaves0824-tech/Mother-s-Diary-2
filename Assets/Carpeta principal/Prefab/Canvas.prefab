  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dia/Mes/A\xF1o\r\nAcabamos de volver del obstetra; te vio sano y fuerte.
    Es un alivio. \xDAltimamente ven\xEDa sinti\xE9ndome muy descompuesta y ten\xEDa
    miedo de que algo te pasara. Vi tu peque\xF1o coraz\xF3n latir por primera vez
    en la pantalla y fue tan hermoso... Siento que vamos a ser una familia muy linda.
    \r\n -Mam\xE1\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aaf8e7ff12f70fd4eb7849fdcd269cd3, type: 2}
  m_sharedMaterial: {fileID: 8301307499868947259, guid: aaf8e7ff12f70fd4eb7849fdcd269cd3, type: 2}
