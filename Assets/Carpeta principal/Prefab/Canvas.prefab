  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " Se acost\xF3 con otra mujer mientras yo sangraba en una camilla. Se sent\xEDa
    solo, dijo. Que ya no me amaba, dijo. Se fue sin llevarse sus cosas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
