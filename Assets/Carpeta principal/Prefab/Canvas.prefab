  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Con el tiempo comenc\xE9 a extra\xF1arte, a extra\xF1ar tus llantos, tu
    sufrimiento. Extra\xF1aba el control que ten\xEDa sobre tu dolor. Fui a tu cuna.
    Te pellizque y nada. Te golpe\xE9 la mejilla y nada. Sab\xEDa que no ibas a reaccionar,
    pero igualmente me decepcion\xE9.\r\n -Mam\xE1\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
  m_sharedMaterial: {fileID: 8301307499868947259, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
