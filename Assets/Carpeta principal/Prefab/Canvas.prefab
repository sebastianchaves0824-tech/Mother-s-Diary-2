  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " Te veo en la cuna y lo veo a \xE9l. Te veo y te detesto. Todo es tu culpa,
    si no fuera por vos, si no me hubieras deformado el cuerpo, quiz\xE1s no se hubiera
    ido. Tal vez seguir\xEDa conmigo, seguir\xEDa am\xE1ndome como lo hac\xEDa cuando
    nos pusimos de novios, como cuando cumplimos nuestro primer a\xF1o juntos, como
    lo hac\xEDa hasta que te apareciste."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
  m_sharedMaterial: {fileID: 8301307499868947259, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
