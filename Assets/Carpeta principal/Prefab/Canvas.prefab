  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hoy por fin me digne a levantarme. No s\xE9 ni qu\xE9 d\xEDa es. Entr\xE9
    a tu habitaci\xF3n, el olor ya era nauseabundo. Llevabas d\xEDas muerto y las
    moscas comenzaron a hacer lo suyo. Intent\xE9 sentirme mal por vos, llorar, tener
    culpa, algo\u2026 pero se me hizo imposible. Sonre\xED, al fin iba a haber algo
    de paz.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
  m_sharedMaterial: {fileID: 8301307499868947259, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
