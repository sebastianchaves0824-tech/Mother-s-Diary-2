  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "(No s\xE9 qu\xE9 d\xEDa es)\r\n La casa se ve horrible, cada d\xEDa est\xE1
    m\xE1s sucia, pero no soy capaz de levantarme de la cama, no quiero hacerlo.
    Te escucho llorar, desde la otra habitaci\xF3n. De hambre supongo. Ans\xEDo con
    toda mi alma el momento en que te calles para siempre.\r\n Morite.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
  m_sharedMaterial: {fileID: 8301307499868947259, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
