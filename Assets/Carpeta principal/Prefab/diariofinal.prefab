  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dia/Mes/A\xF1o\r\n Por fin, luego de tanto tiempo intent\xE1ndolo, pudimos
    quedar embarazados. Estoy tan contenta. Hay tantas cosas que quiero ense\xF1arte,
    tantas cosas que quiero mostrarte. Con tu padre hicimos una apuesta de s\xED
    vas a ser una nena o un nene, y el perdedor va a tener que cambiarte los pa\xF1ales
    durante los primeros 3 meses. Yo siento que vas a ser una mujercita, aunque tampoco
    voy a molestarme si no lo sos. De cualquier forma voy a amarte siempre.\r\n -Mam\xE1\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aaf8e7ff12f70fd4eb7849fdcd269cd3, type: 2}
