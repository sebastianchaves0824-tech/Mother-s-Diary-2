  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dia/Mes/A\xF1o\r\n Mi ni\xF1o precioso, hoy es tu primer d\xEDa de nacido.
    El parto tuvo algunas complicaciones, y el hospital se sent\xEDa tan fr\xEDo
    sin \xE9l, pero llegaste sano y salvo. Decid\xED nombrarte Rom\xE1n, como tu
    pap\xE1, ten\xE9s sus mismos ojos, su misma nariz, su misma boca. Te voy a amar
    con todo mi coraz\xF3n.\r\n -Mama\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
  m_sharedMaterial: {fileID: 8301307499868947259, guid: 1a8e27c8f54fc45489ed3c93de6ef778, type: 2}
